[Version]
Version=1.0.0
Type=Block

[InsertRSIJointPos]
Type=Insert
Before=;FOLD USER TECHFUNCM
What=mxa_techfunc_m.txt
Start=case 2 ; RSI streaming
End=mxA_MsgMan_SetCmdStateM(QIdx,#Executed)

[InsertCancelVar]
Type=Insert
Before=;FOLD USER VARSTECHFUNCS
What=mxa_techfunc_s_var.txt
Start=DECL STATE_T state
End=DECL MODUS_T mode

[InsertCancel]
Type=Insert
Before=;FOLD USER TECHFUNCS
What=mxa_techfunc_s.txt
Start=case 3 ; Cancel
End=CWRITE($CMD, state, mode, "CANCEL 1")

[InsertImpedance]
Type=Insert
Before=;FOLD USER TECHFUNCS
What=mxa_techfunc_s_impedance.txt
Start=case 4 ; Set axis impedance (per-axis stiffness/damping)
End=mxA_MsgMan_SetCmdStateS(QIdx,#Executed)

[InsertCheckPar]
Type=Insert
Before=;FOLD USER TECHFUNCCHECKPAR
What=mxa_techfunc_checkpar.txt
Start=case 3
End=bValuesOK = TRUE

[InsertCheckParImpedance]
Type=Insert
Before=;FOLD USER TECHFUNCCHECKPAR
What=mxa_techfunc_checkpar_impedance.txt
Start=case 4 ; Set axis impedance
End=bValuesOK = bValuesOK AND ((gMxA_CmdQ_Int1[QIdx] MOD 2) == 0)